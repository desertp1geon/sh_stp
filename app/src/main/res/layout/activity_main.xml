<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <variable
            name="viewModel"
            type="com.example.sh_stp.viewmodel.MainActivityViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Інформація про мотоцикл"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/editTextBrand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Марка мотоцикла"
            android:inputType="textCapWords"
            android:autofillHints="none"
            android:text="@={viewModel.uiModel.brand}"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/editTextModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Модель мотоцикла"
            android:inputType="textCapWords"
            android:autofillHints="none"
            android:text="@={viewModel.uiModel.model}"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/editTextYear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Рік випуску"
            android:inputType="number"
            android:autofillHints="none"
            android:text="@={viewModel.uiModel.year}"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/editTextEngineVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Об'єм двигуна (см³)"
            android:inputType="numberDecimal"
            android:autofillHints="none"
            android:text="@={viewModel.uiModel.engineVolume}"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/buttonShowMotorcycle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Показати інформацію"
            android:onClick="@{viewModel::onNextButtonClicked}" />

    </LinearLayout>
</layout>
